<Window x:Class="VideoDedup.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoDedup — Processing" Height="540" Width="1000" MinWidth="650">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="VideoDedup" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Local-only metadata and exact SHA-256 processing. Source files are never modified." Margin="0,8,0,16" />
            <TextBlock Text="Folder path" />
            <TextBox x:Name="Folder" AutomationProperties.Name="Folder path" Margin="0,4,0,10" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="Scan" Content="Scan and process" Click="Scan_Click" Padding="14,6" />
                <Button Content="Cancel scan" Click="Cancel_Click" Margin="10,0" Padding="14,6" />
                <Button Content="Refresh" Click="Refresh_Click" Padding="14,6" />
            </StackPanel>
            <TextBlock x:Name="Status" Text="Ready" Margin="0,12" TextWrapping="Wrap" />
        </StackPanel>
        <DataGrid x:Name="Results" IsReadOnly="True" AutoGenerateColumns="True" AutomationProperties.Name="Processing results" />
    </DockPanel>
</Window>
