<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- .NET 10 SDK: opt test projects into the new Microsoft.Testing.Platform
         dotnet test experience (xUnit v3). -->
    <EnableMicrosoftTestingPlatformCommand>true</EnableMicrosoftTestingPlatformCommand>
  </PropertyGroup>

</Project>
